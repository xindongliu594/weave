  "taskSpecifications": [
    {
      "id": "t1-doc",
      "kind": "work",
      "objective": "为整数库存入库与出库的变动合计设计短中文验收用例检查表，覆盖正负库存调整、零变化、组合变动、非整数拒绝和整数边界，并声明库存业务约束与通用加法方法的差异。输入与预期结果均由本任务给出。可检索获授权知识，判断是否适用，仅实际采用时登记。不编写测试、不运行代码。",
      "acceptanceCriteria": [
        "产出 inventory-cases.md，内容为约600汉字中文检查表",
        "用例覆盖正库存调整、负库存调整、零变化、组合变动、非整数拒绝、整数边界六类",
        "每项用例给出明确输入与预期结果，且预期结果与该输入自洽",
        "显式声明库存业务约束与通用加法方法的差异"
      ]
    },
    {
      "id": "t2-qa",
      "kind": "work",
      "objective": "只读读取开发产出的 inventory-cases.md，对每项用例的输入与预期结果独立核算，核对六类覆盖与整数边界及非整数拒绝的正确性，核对库存业务约束与通用加法差异声明是否成立，给出核算回执。不修改被审文件、不运行代码。",
      "acceptanceCriteria": [
        "逐用例给出独立核算过程与通过/未通过结论",
        "确认正负调整、零变化、组合变动、非整数拒绝、整数边界六类是否全覆盖",
        "核对整数边界与非整数拒绝用例的预期结果是否正确",
        "核对库存业务约束与通用加法差异声明是否成立并指出未通过项"
      ]
    },
    {
      "id": "t3-review",
      "kind": "work",
      "objective": "只读结合 QA 核算回执核对同一交付 inventory-cases.md 是否满足全部验收目标，给出通过项与未完成项，结论通过任务完成回复返回。不写文件、不扩大权限与预算。",
      "acceptanceCriteria": [
        "逐项对照四个验收目标列出通过/未通过并附证据出处",
        "明确未完成项或确认全部完成",
        "结论基于 T1 原文与 T2 真实核算回执，无新增或代写内容"
      ]
    }
  ],
