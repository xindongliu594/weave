{
  "name": "agent-department",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx apps/api/src/migrate.ts",
    "runtime:inspect": "node scripts/runtime-inspect.mjs",
    "runtime:test": "node --test services/agent-runtime/*.test.mjs"
  },
  "dependencies": {
    "express": "5.1.0",
    "lucide-react": "0.468.0",
    "pg": "8.16.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}
