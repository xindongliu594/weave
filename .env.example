# Optional overrides; export these variables before running npm run dev.
DATABASE_URL=postgres://agent_department:local-development-only@127.0.0.1:55432/agent_department
DATA_DIR=.data
TRACE_ROOT=.data/runs
# Optional: remote frontend origins, comma-separated, HTTPS without trailing slash.
# Requires an authenticated reverse proxy; the API still binds only to loopback.
# ALLOWED_ORIGINS=https://47.88.76.167
# Configure the relay Base URL and API key in the local web interface.

# Optional absolute Obsidian Vault path; defaults to DATA_DIR/obsidian-vault.
# OBSIDIAN_VAULT=/path/to/your/vault
