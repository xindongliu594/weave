{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/department.schema.json",
  "title": "Department",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "goal", "manager", "agents", "knowledgeBases"],
  "properties": {
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "description": {"type": "string", "maxLength": 1000},
    "goal": {"type": "string", "minLength": 1, "maxLength": 5000},
    "manager": {"$ref": "agent-profile.schema.json"},
    "agents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {"$ref": "agent-profile.schema.json"}
    },
    "knowledgeBases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "maxConcurrentAgents": {"type": "integer", "minimum": 1, "maximum": 5, "default": 3},
    "requirePlanApproval": {"type": "boolean", "default": true}
  }
}

