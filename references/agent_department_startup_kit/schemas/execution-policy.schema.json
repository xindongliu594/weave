{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/execution-policy.schema.json",
  "title": "ExecutionPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": ["currency", "maxBudget", "maxAgents", "maxConcurrentAgents", "deadlineSeconds", "allowedModelCatalogIds", "allowedTools", "allowedKnowledgeBases", "network", "externalWrite", "approvalMode"],
  "properties": {
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "maxBudget": {"type": "number", "exclusiveMinimum": 0},
    "maxPlanningBudget": {"type": "number", "minimum": 0},
    "maxAgents": {"type": "integer", "minimum": 1, "maximum": 20},
    "maxConcurrentAgents": {"type": "integer", "minimum": 1, "maximum": 20},
    "deadlineSeconds": {"type": "integer", "minimum": 60, "maximum": 604800},
    "allowedModelCatalogIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "allowedTools": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "allowedKnowledgeBases": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "network": {"enum": ["denied", "allowlist", "allowed"]},
    "externalWrite": {"enum": ["denied", "approval_required", "allowed"]},
    "approvalMode": {"enum": ["plan_only", "risky_actions", "all_actions"]},
    "automaticApprovalThreshold": {"type": ["number", "null"], "minimum": 0}
  }
}

