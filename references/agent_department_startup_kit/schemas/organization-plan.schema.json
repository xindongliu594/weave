{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/organization-plan.schema.json",
  "title": "OrganizationPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["multiAgentJustification", "department", "manager", "agents", "tasks", "estimate", "risk"],
  "properties": {
    "multiAgentJustification": {"type": "string", "minLength": 1, "maxLength": 2000},
    "department": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "goal"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "goal": {"type": "string", "minLength": 1, "maxLength": 5000}
      }
    },
    "manager": {"$ref": "#/$defs/plannedAgent"},
    "agents": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/plannedAgent"}},
    "tasks": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/task"}},
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "planningCost", "executionCost", "verificationCost", "retryReserve", "total", "durationSeconds"],
      "properties": {
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "planningCost": {"type": "number", "minimum": 0},
        "executionCost": {"type": "number", "minimum": 0},
        "verificationCost": {"type": "number", "minimum": 0},
        "retryReserve": {"type": "number", "minimum": 0},
        "total": {"type": "number", "minimum": 0},
        "durationSeconds": {"type": "integer", "minimum": 1}
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "reasons"],
      "properties": {
        "level": {"enum": ["low", "medium", "high"]},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "degradationPlan": {"type": ["string", "null"], "maxLength": 5000}
  },
  "$defs": {
    "plannedAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "roleTitle", "instructions", "modelCatalogId", "knowledgeBases", "tools", "maxCost"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "roleTitle": {"type": "string", "minLength": 1, "maxLength": 100},
        "instructions": {"type": "string", "minLength": 1, "maxLength": 10000},
        "modelCatalogId": {"type": "string", "minLength": 1},
        "knowledgeBases": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "tools": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "maxCost": {"type": "number", "minimum": 0}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "objective", "assigneeId", "dependencies", "acceptanceCriteria"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"},
        "subject": {"type": "string", "minLength": 1, "maxLength": 200},
        "objective": {"type": "string", "minLength": 1, "maxLength": 5000},
        "assigneeId": {"type": "string"},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "acceptanceCriteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}

