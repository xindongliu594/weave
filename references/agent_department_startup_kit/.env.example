# Copy to .env. Do not commit real secrets.
APP_ENV=development
WEB_PORT=3000
API_PORT=4000

POSTGRES_DB=agent_department
POSTGRES_USER=agent_department
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgresql://agent_department:change_me_local_only@postgres:5432/agent_department
REDIS_URL=redis://redis:6379/0

ARTIFACT_ROOT=/data/artifacts
DSH_BASE_URL=http://dsh-runtime:3080
DSH_PROFILE=web

# The planner selects worker models only from the server-side model catalog.
PLANNER_MODEL_CATALOG_ID=
DEFAULT_CREATION_MODE=recommended
DEFAULT_MAX_AGENTS=5
DEFAULT_MAX_CONCURRENT_AGENTS=3
AUTOMATIC_APPROVAL_ENABLED=false

# Store real keys in a local secret store or uncommitted .env only.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

OLLAMA_BASE_URL=http://ollama:11434
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
